{
  "name": "SM Ganadero · Campo",
  "short_name": "SM Ganadero",
  "description": "Consulta del propietario y registro de campo del veterinario, incluso sin internet.",
  "id": "/mobile/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f7fb",
  "theme_color": "#202c46",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [".smpair", ".smprop", ".smvet", ".smtrabajo", "text/plain", "application/json", "application/octet-stream", "application/x-sm-pairing", "application/vnd.smganadero.pairing", "application/vnd.smganadero.owner-update"]
        }
      ]
    }
  },
  "file_handlers": [
    { "action": "./?recibir=archivo", "accept": { "text/plain": [".smpair"], "application/json": [".smprop", ".smvet", ".smtrabajo"] } }
  ]
}
